# Trading Signals Platform - Environment Variables

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here_get_from_botfather

# Database (Production only - MVP uses in-memory)
DATABASE_URL=postgresql://user:password@localhost:5432/trading_signals

# API Configuration
API_BASE_URL=http://localhost:8000
PORT=8000
DEBUG=true

# Screening Schedule
SCREENING_HOUR=17
SCREENING_MINUTE=0
SCREENING_TIMEZONE=UTC

# Data Fetching
YFINANCE_TIMEOUT=30
MARKET_DATA_CACHE_HOURS=1
